# These variables should be populated if building images outside the GitHub Actions workflow
ARG VERSION="9.70.4"
ARG REGISTRY_REPO="docker.io/library"

# Re-use minimal image as base layer
FROM ${REGISTRY_REPO}/arm:${VERSION}-linux-minimal

# Reuse previous arguments in this stage
ARG VERSION

# Intall additional IAR Build Tools
RUN wget -qO- "https://github.com/iarsystems/arm/releases/download/${VERSION}/cxarm-${VERSION}-linux-x86_64-base.tar.bz2" | tar -I lbzip2 --skip-old-files -x -C '/opt/iar'
