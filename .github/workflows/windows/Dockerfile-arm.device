# These variables should be populated if building images outside the GitHub Actions workflow
ARG VERSION
ARG VARIANT
ARG TIMESTAMP
ARG REGISTRY_REPO
ARG WINVER

# Re-use base image as base layer
FROM ${REGISTRY_REPO}/arm:${VERSION}-windows-${WINVER}-base

# Reuse previous arguments in this stage
ARG VERSION
ARG VARIANT
ARG TIMESTAMP

# Intall Device support
RUN Invoke-WebRequest -Uri "https://github.com/iarsystems/arm/releases/download/${env:VERSION}/cxarm-device-support-${env:VARIANT}-${env:VERSION}.${env:TIMESTAMP}.zip" -OutFile "device_support.zip"; \
Expand-Archive "device_support.zip" -DestinationPath "C:/iar"; \
Remove-Item "device_support.zip";
