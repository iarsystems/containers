# These variables should be populated if building images outside the GitHub Actions workflow
ARG VERSION="10.10.2"
ARG VARIANT="st"
ARG REGISTRY_REPO="docker.io/library"

# Re-use base image as base layer
FROM ${REGISTRY_REPO}/arm:${VERSION}-linux-base

# Reuse previous arguments in this stage
ARG VERSION
ARG VARIANT

# Intall Device support
RUN wget -qO- $(curl -s https://api.github.com/repos/iarsystems/arm/releases/tags/${VERSION} \
    | jq -r --arg PAT "device-support-${VARIANT}.*\\.bz2" '.assets[] | select(.name | test($PAT)) | .browser_download_url') \
    | tar -I lbzip2 -x -C '/opt/iar'