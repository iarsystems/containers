# escape=`
# These variables should be populated if building images outside the GitHub Actions workflow
ARG WINVER=2025

# The windows/servercore image is required for the tools included in -full
FROM mcr.microsoft.com/windows/servercore:ltsc${WINVER}

# Forward the ARGs to the current stage
ARG VERSION
ARG BUILD_VER

LABEL org.opencontainers.image.description="IAR Build Tools for Renesas RL78 (CX)"
LABEL org.opencontainers.image.ref_name="cxrl78"
LABEL org.opencontainers.image.source="https://iar.com"
LABEL org.opencontainers.image.vendor="IAR Systems AB"
LABEL org.opencontainers.image.version=${VERSION}

# Set PowerShell as default shell for RUN
SHELL ["powershell.exe", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Install Latest CMake
RUN `
    $latestCMake = Invoke-RestMethod -Uri 'https://api.github.com/repos/kitware/cmake/releases/latest'; `
    $downloadURL = ($latestCMake.assets | Where-Object { $_.name -like 'cmake-*-windows-x86_64.zip' }).browser_download_url; `
    $fileName = ($latestCMake.assets | Where-Object { $_.name -like 'cmake-*-windows-x86_64.zip' }).name; `
    $baseDir = [System.IO.Path]::GetFileNameWithoutExtension("$fileName"); `
    Invoke-WebRequest -Uri "$downloadURL" -OutFile "$fileName"; `
    Expand-Archive -Path "$fileName" -DestinationPath 'C:\'; `
    Remove-Item -Path "*.zip"; `
    [Environment]::SetEnvironmentVariable('PATH', $env:PATH + ';' + 'C:\' + $baseDir + '\bin', [EnvironmentVariableTarget]::Machine)

# Install Latest Git
RUN `
    $latestGit4W = Invoke-RestMethod -Uri 'https://api.github.com/repos/git-for-windows/git/releases/latest'; `
    $downloadURL = ($latestGit4W.assets | Where-Object { $_.name -like 'MinGit-*-busybox-64-bit.zip' }).browser_download_url; `
    $fileName = ($latestGit4W.assets | Where-Object { $_.name -like 'MinGit-*-busybox-64-bit.zip' }).name; `
    $baseDir = [System.IO.Path]::GetFileNameWithoutExtension("$fileName"); `
    Invoke-WebRequest -Uri "$downloadURL" -OutFile "$fileName"; `
    Expand-Archive -Path "$fileName" -DestinationPath ('C:\' + $baseDir); `
    Remove-Item -Path "*.zip"; `
    [Environment]::SetEnvironmentVariable('PATH', $env:PATH + 'C:\' + $baseDir + '\cmd', [EnvironmentVariableTarget]::Machine)

# Install VC++ Runtime Libraries (required for: iarbuild.exe, cspybat.exe)
RUN `
    Invoke-WebRequest -Uri "https://aka.ms/vs/17/release/vc_redist.x64.exe" -OutFile "C:/vc_redist.x64.exe"; `
    Start-Process -FilePath "C:/vc_redist.x64.exe" -ArgumentList "/install", "/quiet", "/norestart" -Wait; `
    Remove-Item -Path "vc_redist.x64.exe"; `
    $version=$env:VERSION; `
    [Environment]::SetEnvironmentVariable('PATH', $env:PATH + 'C:\iar\cxrl78-' + $version + '\common\bin', [EnvironmentVariableTarget]::Machine)

# Install the IAR Build Tools for Renesas RL78 (full)
RUN `
    $version = $env:VERSION; `
    $v = [version]$version; `
    $majorMinor = "$($v.Major).$($v.Minor)"; `
    $versionre = '*' + $version + '*.exe'; `
    $uri = 'https://updates.iar.com/?product=CXRL78&version=' + $majorMinor; `
    $currentCX = (Invoke-WebRequest -Uri $uri -UseBasicParsing).Links | `
      Where-Object { $_.href -like $versionre } | Select-Object -ExpandProperty href; `
    $fileName = (Split-Path -Path "$currentCX" -Leaf); `
    Invoke-WebRequest -Uri "$currentCX" -OutFile "$fileName" -UseBasicParsing; `
    Start-Process -FilePath "$fileName" -ArgumentList "/hide_usd","/autoinstall" -wait; `
    Remove-Item "$fileName"; `
    [Environment]::SetEnvironmentVariable('PATH', $env:PATH + 'C:\iar\cxrl78-' + $version + '\rl78\bin', [EnvironmentVariableTarget]::Machine);

# Install the IAR LMSC Tools
RUN `
    $latestLMSC = (Invoke-WebRequest -Uri 'https://updates.iar.com/?product=LMSCDAEMON&version=1.14' -UseBasicParsing).Links | `
      Where-Object { $_.href -like '*.exe' } | Select-Object -ExpandProperty href; `
    $fileName = (Split-Path -Path "$latestLMSC" -Leaf); `
    Invoke-WebRequest -Uri "$latestLMSC" -OutFile "$fileName" -UseBasicParsing; `
    Start-Process -FilePath "$fileName" -ArgumentList "/VERYSILENT","/SUPPRESSMSGBOXES","/DIR=C:\iar\lmsc" -wait; `
    Remove-Item -Path "iar-lmsc-tools*.exe"; `
    [Environment]::SetEnvironmentVariable('PATH', $env:PATH + 'C:\iar\lmsc', [EnvironmentVariableTarget]::Machine)

# Set the work directory
WORKDIR "C:/workdir"
